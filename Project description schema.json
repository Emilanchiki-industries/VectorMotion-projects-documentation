{
    "$schema": "https://json-schema.org/draft/2019-09/schema",
    "$defs": {
        "identifier": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "\\S+"
        },
        "shortStringInput": {
            "type": "string",
            "pattern": "\\S",
            "minLength": 10,
            "maxLength": 500
        },
        "longStringInput": {
            "type": "string",
            "pattern": "\\S",
            "minLength": 10,
            "maxLength": 1500
        },
        "description": {
            "title": "description",
            "$ref": "#/$defs/shortStringInput"
        },
        "hints": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "patternProperties": {
                "^\\S+.*\\?": {
                    "title": "hint",
                    "description": "Specifies a question as a property name and an answer for it as a property value",
                    "$ref": "#/$defs/longStringInput"
                }
            }
        },
        "layers": {
            "title": "layer",
            "description": "Specifies a layer explanation",
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "patternProperties": {
                "^\\S+.*\\S$": {
                    "title": "layer name",
                    "description": "Specifies a layer name",
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "description"
                    ],
                    "properties": {
                        "description": {
                            "description": "Specifies a layer description",
                            "$ref": "#/$defs/description"
                        },
                        "dependencies": {
                            "title": "dependencies",
                            "description": "Specifies layer dependencies",
                            "type": "array",
                            "uniqueItems": true,
                            "minItems": 1,
                            "items": {
                                "title": "dependency",
                                "oneOf": [
                                    {
                                        "description": "Specifies a static layer dependency by name pattern\nThis layer dependency is not intended to be changed by the user",
                                        "type": "string",
                                        "minLength": 1,
                                        "pattern": "\\S+",
                                        "examples": []
                                    },
                                    {
                                        "description": "Specifies a static or dynamic layer dependency explicitly by name pattern",
                                        "type": "object",
                                        "additionalProperties": false,
                                        "required": [
                                            "type",
                                            "pattern"
                                        ],
                                        "properties": {
                                            "type": {
                                                "title": "type",
                                                "description": "Specifies a layer dependency type",
                                                "type": "string",
                                                "oneOf": [
                                                    {
                                                        "description": "Specifies that the layer dependency is not intended to be changed by the user",
                                                        "const": "static"
                                                    },
                                                    {
                                                        "description": "Specifies that the layer dependency is can be changed by the user but just to the one matching name pattern",
                                                        "const": "dynamic"
                                                    }
                                                ]
                                            },
                                            "pattern": {
                                                "title": "pattern",
                                                "description": "Specifies a layer dependency name pattern explicitly",
                                                "$ref": "#/$defs/identifier"
                                            }
                                        }
                                    }
                                ]
                            }
                        },
                        "hints": {
                            "title": "hints",
                            "description": "Specifies hints with questions and answers possibly asked by a user",
                            "$ref": "#/$defs/hints"
                        }
                    }
                }
            }
        },
        "scenes": {
            "title": "scene",
            "description": "Specifies a scene explanation",
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "patternProperties": {
                "^\\S+.*\\S$": {
                    "title": "scene name",
                    "description": "Specifies a scene name",
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "description",
                        "usage"
                    ],
                    "properties": {
                        "description": {
                            "description": "Specifies a scene description",
                            "$ref": "#/$defs/description"
                        },
                        "usage": {
                            "title": "",
                            "description": "Specifies a usage type",
                            "type": "string",
                            "default": "public",
                            "oneOf": [
                                {
                                    "description": "Public scene is used by the user with possible some of its layers locked",
                                    "const": "public"
                                },
                                {
                                    "description": "Internal scene is made for impelemntation purposes with all its layers locked",
                                    "const": "internal"
                                }
                            ]
                        },
                        "layers": {
                            "title": "layers",
                            "description": "Specifies layers explanations",
                            "$ref": "#/$defs/layers"
                        }
                    }
                }
            }
        },
        "collections": {
            "title": "collections",
            "description": "Specifies an explanation for a logical groups of multiple scenes",
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "patternProperties": {
                "^\\S+.*\\S$": {
                    "title": "collection name",
                    "description": "Specifies a collection name",
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "description"
                    ],
                    "properties": {
                        "description": {
                            "description": "Specifies a collection description",
                            "$ref": "#/$defs/description"
                        },
                        "scenes": {
                            "title": "scenes",
                            "description": "Specifies scenes explanations",
                            "$ref": "#/$defs/scenes"
                        }
                    }
                }
            }
        }
    },
    "title": "project explanation",
    "description": "Specifies project explanation",
    "$ref": "#/$defs/collections"
}